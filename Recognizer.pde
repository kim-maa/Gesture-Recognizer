int heightWindow;
int templateMargin;
int templateSize;
int columns = 4;
int rows = 2;
int leftMargin;
int rightMargin;

Gesture inputGesture;
float errorThreshold;
boolean drawingGesture = false;

float[][][] templates = new float[8][][];
Gesture[] templateGestures;
String[] templateNames = {
  "Slow-Fast-Fast",
  "Fast-Fast-Slow",
  "Fast-Pause-Fast-Fast",
  "Fast-Fast-Pause-Fast",
  "Stable",
  "Speedup",
  "Slowdown",
  "Square"
};

void settings() {
  int expWidth = int(displayWidth * 0.8);
  int expHeight = int(displayHeight * 0.92);
  size(expWidth, expHeight);
}

void setup() {  
  // layout setup
  heightWindow = int(height * 0.5);
  templateMargin = int(height * 0.02);
  leftMargin = int(width * 0.02);
  rightMargin = leftMargin;
  templateSize = int((width - leftMargin - rightMargin) / columns * 0.63);
  
  // initialize gesture templates with recorded data, turn them into Gesture objects
  generateTemplates();
  templateGestures = new Gesture[templates.length];
  for (int i = 0; i < templates.length; i++) {
    templateGestures[i] = templateToGesture(templates[i]);
  }
  errorThreshold = 6.5;
}

void draw() {
  background(200);
  
  // draw gesture area
  stroke(0);
  noFill();
  rect(0, 0, width, heightWindow);
  
  // show gesture being drawn
  if (drawingGesture) {
    inputGesture.drawGesture();
  } else {
    // display resampled gesture
    if (inputGesture != null && inputGesture.resampledGesture.size() > 0) {
      inputGesture.drawResampledInputGesture(10, 40, 300);
    }
  }
  drawTemplates();
}

void mousePressed() {
  if (mouseY < heightWindow) {
    loop();
    background(255);
    inputGesture = new Gesture();
    drawingGesture = true;
    inputGesture.startTime = millis();
    inputGesture.addPoint(mouseX, mouseY, 0);
  }
}

void mouseDragged() {
  if (mouseY < heightWindow && drawingGesture) {
    inputGesture.addPoint(mouseX, mouseY, millis() - inputGesture.startTime);
  }
}

void mouseReleased() {
  if (mouseY < heightWindow && drawingGesture) {
    inputGesture.addPoint(mouseX, mouseY, millis() - inputGesture.startTime);
    drawingGesture = false;
    inputGesture.resamplePoints();
    inputGesture.drawResampledInputGesture(10, 50, 300);
    
    match();
    noLoop();
  }
}

/**
 * Compare the current gesture to each template and print out the error scores.
 * Also determine and print the best match.
 */
void match() {
  float lowestError = errorThreshold;
  String bestMatchedTemplate = "";
  
  // loop through each template and compare
  for (int i = 0; i < templateGestures.length; i++) {
    // convert hard-coded template to a Gesture object
    float error = inputGesture.compare(templateGestures[i]);
    println(templateNames[i] + ": " + error);
    
    // check if input gesture no longer reasonable matches any template
    if (error < lowestError) {
      lowestError = error;
      bestMatchedTemplate = templateNames[i];
    }
    
    //overlay input gesture over templates
    int col = i % columns;
    int row = i / columns;
    float x = leftMargin + col * templateSize;
    float y = heightWindow + templateMargin + row * templateSize;
   
    // overlay the current gesture in purple
    stroke(102, 0, 204);
    noFill();
    pushMatrix();
    translate(x, y);
    beginShape();
    for (int j = 0; j < inputGesture.resampledGesture.size(); j++) {
      float xPos = map(j, 0, inputGesture.resampledGesture.size() - 1, 0, templateSize);
      float yPos = map(inputGesture.resampledGesture.get(j).t, 0, 1, templateSize, 0);
      vertex(xPos, yPos);
    }
    endShape();
    popMatrix();
  }
  
  if (bestMatchedTemplate.equals("")) {
    println("No valid match found. Please try drawing your gesture again");
  } else {
    println("Best match template: " + bestMatchedTemplate + " with error value of " + lowestError);
  }
}


/** 
* Draw the template grid at the bottom of the canvas.
*/
void drawTemplates() {
  int offsetY = heightWindow + templateMargin;
  
  for (int i = 0; i < templates.length; i++) {
    int col = i % columns;
    int row = i / columns;
    float x = leftMargin + col * templateSize;
    float y = offsetY + row * templateSize;
    
    pushMatrix();
    translate(x, y);
    
    // borders of templates
    stroke(0);
    noFill();
    rect(0, 0, templateSize, templateSize);
    
    // template in red
    stroke(255, 0, 0);
    noFill();
    beginShape();
    float[][] pts = templates[i];
    for (int j = 0; j < pts.length; j++) {
      float xPos = map(j, 0, pts.length - 1, 0, templateSize);
      float yPos = map(pts[j][2], 0, 1, templateSize, 0);
      vertex(xPos, yPos);
    }
    endShape();
    
    fill(0);
    textSize(12);
    text(templateNames[i], 10, 20);
    popMatrix();
  }
}

/**
 * Convert a template (stored as a float[][] array) into a Gesture object.
 */
public Gesture templateToGesture(float[][] template) {
  Gesture gesture = new Gesture();
  for (int i = 0; i < template.length; i++) {
    float x = template[i][0];
    float y = template[i][1];
    float t = template[i][2];

    gesture.resampledGesture.add(new Point(x, y, t));
  }
  return gesture;
}

